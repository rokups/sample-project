{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/cmake-build/${presetName}",
      "installDir": "${sourceDir}/cmake-build/${presetName}/install",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;RelWithDebInfo",
        "CMAKE_POLICY_DEFAULT_CMP0127": "NEW",
        "SAMPLE_PROJECT_CSHARP": "OFF"
      }
    },
    {
      "name": "base-lib",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "base-dll",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "sdk-prefix-path",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{RBFX_SDK_ROOT};$env{SHARPCPP_SDK_ROOT}"
      }
    },
    {
      "name": "sdk-find-root-path",
      "hidden": true,
      "inherits": "sdk-prefix-path",
      "cacheVariables": {
        "CMAKE_FIND_ROOT_PATH": "$env{RBFX_SDK_ROOT};$env{SHARPCPP_SDK_ROOT}"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": ["base", "sdk-prefix-path"],
      "generator": "Visual Studio 18 2026"
    },
    {
      "name": "windows-msvc-x64-lib",
      "inherits": ["windows-base", "base-lib"],
      "architecture": "x64"
    },
    {
      "name": "windows-msvc-x64-dll",
      "inherits": ["windows-base", "base-dll"],
      "architecture": "x64"
    },
    {
      "name": "base-gnu-x64",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-m64",
        "CMAKE_CXX_FLAGS": "-m64"
      }
    },
    {
      "name": "base-gcc",
      "hidden": true,
      "environment": {
        "CC": "gcc",
        "CXX": "g++"
      }
    },
    {
      "name": "base-clang",
      "hidden": true,
      "environment": {
        "CC": "clang",
        "CXX": "clang++"
      }
    },
    {
      "name": "linux-gcc-x64-lib",
      "inherits": ["base-gcc", "base-gnu-x64", "base-lib", "sdk-prefix-path"]
    },
    {
      "name": "linux-gcc-x64-dll",
      "inherits": ["base-gcc", "base-gnu-x64", "base-dll", "sdk-prefix-path"]
    },
    {
      "name": "linux-clang-x64-lib",
      "inherits": ["base-clang", "base-gnu-x64", "base-lib", "sdk-prefix-path"]
    },
    {
      "name": "linux-clang-x64-dll",
      "inherits": ["base-clang", "base-gnu-x64", "base-dll", "sdk-prefix-path"]
    },
    {
      "name": "macos-clang-x64-lib",
      "generator": "Xcode",
      "inherits": ["base-lib", "sdk-prefix-path"],
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64"
      }
    },
    {
      "name": "macos-clang-x64-dll",
      "generator": "Xcode",
      "inherits": ["base-dll", "sdk-prefix-path"],
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64"
      }
    },
    {
      "name": "macos-clang-arm64-lib",
      "generator": "Xcode",
      "inherits": ["base-lib", "sdk-prefix-path"],
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "macos-clang-arm64-dll",
      "generator": "Xcode",
      "inherits": ["base-dll", "sdk-prefix-path"],
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "android-base",
      "hidden": true,
      "inherits": ["base-dll"],
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.10",
        "CMAKE_PREFIX_PATH": "$env{RBFX_SDK_ROOT};$env{RBFX_HOST_SDK_ROOT};$env{SHARPCPP_SDK_ROOT}",
        "CMAKE_FIND_ROOT_PATH": "$env{RBFX_SDK_ROOT};$env{RBFX_HOST_SDK_ROOT};$env{SHARPCPP_SDK_ROOT}",
        "ANDROID_PLATFORM": "android-21",
        "ANDROID_STL": "c++_static"
      }
    },
    {
      "name": "android-clang-arm-dll",
      "inherits": "android-base",
      "cacheVariables": {
        "ANDROID_ABI": "armeabi-v7a",
        "ANDROID_ARM_MODE": "arm"
      }
    },
    {
      "name": "android-clang-arm64-dll",
      "inherits": "android-base",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a"
      }
    },
    {
      "name": "android-clang-x64-dll",
      "inherits": "android-base",
      "cacheVariables": {
        "ANDROID_ABI": "x86_64"
      }
    },
    {
      "name": "web-emscripten-wasm-lib",
      "inherits": ["base-lib", "sdk-find-root-path"],
      "cacheVariables": {
        "CI_WEB_BUILD": "ON",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "EMSCRIPTEN_ROOT_PATH": "$env{EMSDK}/upstream/emscripten/"
      }
    },
    {
      "name": "ios-clang-arm64-lib",
      "generator": "Xcode",
      "inherits": ["base-lib", "sdk-find-root-path"],
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{RBFX_SDK_ROOT}/share/Urho3D/CMake/Toolchains/IOS.cmake",
        "PLATFORM": "OS64",
        "DEPLOYMENT_TARGET": "15.0",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED": "NO"
      }
    }
  ],
